font-family = "FiraMono Nerd Font Mono"
font-size = 14

mouse-hide-while-typing = true

shell-integration = zsh

theme = TokyoNight

keybind = global:super+shift+plus=toggle_quick_terminal
quick-terminal-animation-duration = 0.1
keybind = shift+enter=text:\n

# subtle TokyoNight row highlight (bg #1a1b26), used by taskwarrior color.alternate
palette = 235=#1f2231

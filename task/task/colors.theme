# TokyoNight: color0-15 resolve to the terminal palette (Ghostty theme = TokyoNight),
# rgb531 approximates the orange (#ff9e64) that has no ANSI slot.
rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=color4
color.label.sort=color5
color.alternate=on color235
color.header=color4
color.footnote=color8
color.warning=color3
color.error=color0 on color1
color.debug=color8

# Task state
color.completed=color8
color.deleted=color8
color.active=color0 on color2
color.recurring=color6
color.scheduled=color4
color.until=
color.blocked=color8
color.blocking=color5

# Project
color.project.none=

# Priority
color.uda.priority.H=rgb531
color.uda.priority.M=color3
color.uda.priority.L=color8

# Tags
color.tag.next=bold color5
color.tag.none=
color.tagged=

# Due
color.due.today=bold color3
color.due=color6
color.overdue=bold color1

# Report: burndown
color.burndown.done=on color2
color.burndown.pending=on color1
color.burndown.started=on color3

# Report: history
color.history.add=color0 on color4
color.history.delete=color0 on color1
color.history.done=color0 on color2

# Report: summary
color.summary.background=on color235
color.summary.bar=color0 on color2

# Command: calendar
color.calendar.due.today=color0 on color3
color.calendar.due=color0 on color6
color.calendar.holiday=color0 on color5
color.calendar.overdue=color0 on color1
color.calendar.today=color0 on color4
color.calendar.weekend=color8
color.calendar.weeknumber=color8

# Command: sync
color.sync.added=color2
color.sync.changed=color3
color.sync.rejected=color1

# Command: undo
color.undo.after=color2
color.undo.before=color1
